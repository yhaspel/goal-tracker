{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "family-board-local",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "env": {
    "production": {
      "name": "family-board-production",
      "workers_dev": true,
      "minify": true,
      "define": { "__ENABLE_DIAGNOSTICS__": "false" },
      "durable_objects": { "bindings": [{ "name": "HOUSEHOLD", "class_name": "HouseholdDO" }] },
      "exports": { "HouseholdDO": { "type": "durable-object", "storage": "sqlite" } },
      "vars": { "DEPLOYMENT_ENV": "production" }
    },
    "test": {
      "name": "family-board-test",
      "workers_dev": true,
      "define": { "__ENABLE_DIAGNOSTICS__": "true" },
      "durable_objects": { "bindings": [{ "name": "HOUSEHOLD", "class_name": "TestHouseholdDO" }] },
      "exports": { "TestHouseholdDO": { "type": "durable-object", "storage": "sqlite" } },
      "vars": { "DEPLOYMENT_ENV": "test" }
    },
    "restore": {
      "name": "family-board-restore",
      "workers_dev": false,
      "minify": true,
      "define": { "__ENABLE_DIAGNOSTICS__": "false" },
      "durable_objects": { "bindings": [{ "name": "HOUSEHOLD", "class_name": "RestoreHouseholdDO" }] },
      "exports": { "RestoreHouseholdDO": { "type": "durable-object", "storage": "sqlite" } },
      "vars": { "DEPLOYMENT_ENV": "restore" }
    }
  }
}
